<section class="section">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% if section.settings.collection != blank %}
      {% assign featured_collection = collections[section.settings.collection] %}
      <div class="grid grid--products">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <a class="product-card" href="{{ product.url }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}">
            {% endif %}
            <div class="product-card__title">{{ product.title }}</div>
            <div class="price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p>Assign a collection in the theme editor to feature products here.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest drop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
