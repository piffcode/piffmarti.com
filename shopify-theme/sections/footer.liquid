<footer class="site-footer">
  <div class="container">
    <div class="newsletter">
      <h2 class="section-title">{{ 'footer.newsletter' | t }}</h2>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Email address" required>
        <button class="button" type="submit">{{ 'footer.subscribe' | t }}</button>
      {% endform %}
    </div>
    <p>© <span data-current-year></span> {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
